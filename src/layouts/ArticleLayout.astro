---
import DashboardLayout from "./DashboardLayout.astro";
import Indice from "../components/Indice.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"amd" | "apis" | "extra" | "intel" | "nvidia" | "general">;
  title: string;
}

const { entry, title } = Astro.props;
const { vendorLabel, description, heroBackground } = entry.data;
---

<DashboardLayout background={heroBackground}>
  <Indice slot="sidebar" />

  <section class="hero h-full">
    <div class="hero-overlay bg-black/50" aria-hidden="true"></div>

    <div class="hero-content w-full p-6 flex flex-col gap-6">
      <!-- Card con título + descripción -->
      <div class="glass rounded-box w-full p-8">
        <nav class="breadcrumbs text-sm" aria-label="Breadcrumbs">
          <ul>
            <li><a href="/"><i class="bi bi-house-fill" aria-hidden="true"></i> Inicio</a></li>
            <li>{vendorLabel}</li>
            <li aria-current="page">{title}</li>
          </ul>
        </nav>
        <h1 class="text-5xl font-bold mb-6" aria-label={title}>{title}</h1>
        <p class="antialiased">{description}</p>
      </div>

      <slot />
    </div>
  </section>
</DashboardLayout>
